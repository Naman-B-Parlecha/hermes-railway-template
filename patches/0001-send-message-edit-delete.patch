+async def _edit_on_platform(platform, pconfig, chat_id, message_id, message):
+    """Dispatch an edit to the correct platform helper.
+
+    Mirrors `_send_to_platform` but for edits. Only platforms that have an
+    edit helper here are supported; others fall through to an explicit
+    "not yet implemented" error so callers don't silently re-send.
+    """
+    from gateway.config import Platform
+
+    if platform == Platform.SLACK:
+        # Apply the same mrkdwn formatting the send path uses (the slack
+        # plugin's _standalone_send does the same via SlackAdapter.format_message)
+        # so bold / links render identically after the edit.
+        try:
+            from plugins.platforms.slack.adapter import SlackAdapter
+            slack_adapter = SlackAdapter.__new__(SlackAdapter)
+            message = slack_adapter.format_message(message)
+        except Exception:
+            logger.debug("Failed to apply Slack mrkdwn formatting for edit", exc_info=True)
+        return await _edit_slack(pconfig.token, chat_id, message_id, message)
+
+    return {
+        "error": (
+            f"action='edit' is not yet implemented for {platform.value}. "
+            f"Currently supported: slack."
+        )
+    }
+
